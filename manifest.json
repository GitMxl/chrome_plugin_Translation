{
  "manifest_version": 3,
  "name": "本地划词翻译",
  "version": "1.0.0",
  "description": "WebGPU 本地多语言翻译，默认无需 API Key，支持划词、整页、图片及双语字幕。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "unlimitedStorage", "activeTab", "contextMenus"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*", "https://*.huggingface.co/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "本地划词翻译 · 设置", "default_popup": "options.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["languages.js", "page-translator.js", "subtitle-translator.js", "content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*;" }
}
